# 이 파일을 복사해 frontend/.env 로 만들어 사용한다. (.env 는 git에 올라가지 않음)
# 값이 없으면 코드의 기본값(OpenFreeMap liberty, http://localhost:8080)을 사용한다.

# 기본 지도(basemap) 스타일 URL. 제공자를 바꿀 때는 이 값만 바꾼다.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# 백엔드(Spring Boot) API 주소
VITE_API_BASE_URL=http://localhost:8080
